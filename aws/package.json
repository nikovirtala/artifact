{
  "name": "aws",
  "version": "0.0.0",
  "private": true,
  "description": "Dev tooling for the AWS deployment: the S3 dev harness and the test resources stack",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:e2e": "node scripts/e2e.ts",
    "test:e2e:fake": "node scripts/e2e.ts --fake",
    "test:s3": "node scripts/s3-tests.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e:fake",
    "dev:serve": "node bin/artifact-s3.ts serve",
    "synth": "cdk synth --quiet --no-notices"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "typescript": "7.0.2"
  }
}
