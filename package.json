{
  "name": "@nikovirtala/artifact",
  "version": "1.0.0",
  "description": "Local server that hosts HTML artifacts at stable URLs with immutable versions and live reload",
  "license": "MIT",
  "keywords": [
    "artifacts",
    "html",
    "mcp",
    "live-reload",
    "claude-code",
    "cli"
  ],
  "homepage": "https://github.com/nikovirtala/artifact#readme",
  "bugs": "https://github.com/nikovirtala/artifact/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovirtala/artifact.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "artifact": "dist/cli/main.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cdk": {
      "artifact-source": "./src/cdk/index.ts",
      "types": "./dist/cdk/index.d.ts",
      "default": "./dist/cdk/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "cdk": [
        "dist/cdk/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm bundle && pnpm test && pnpm --filter aws check && pnpm --filter artifact-personal check",
    "test:pack": "node scripts/pack-test.ts",
    "test:s3": "pnpm --filter aws test:s3",
    "clean": "node scripts/clean.ts",
    "bundle": "node scripts/bundle-assets.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cdk.json && node scripts/fix-dts.ts && node scripts/copy-assets.ts && pnpm bundle",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
